#!/bin/sh
# Pinentry fallback with debugging
# Version: 2.1 - Debug and environment detection
# Timestamp: 2025-01-13T20:07Z

set -eu

# Configuration
SCRIPT_NAME="$(basename "$0")"
LOG_FILE="$HOME/.logs/pinentry-debug.log"

# Debug logging function
debug_log() {
    local msg="[$(date '+%Y-%m-%d %H:%M:%S')] $SCRIPT_NAME: $*"
    echo "$msg"  "$LOG_FILE"
}

# Setup logging
enhanced_logging() {
    local logs_dir="$HOME/.logs"
    if [ ! -d "$logs_dir" ]; then
        mkdir -p "$logs_dir" 2/dev/null || {
            LOG_FILE="/tmp/pinentry-debug-$USER.log"
            debug_log "Log directory creation failed, using temp file"
        }
    fi
}

# Setup terminal
setup_terminal() {
    export GPG_TTY="$(tty)"
    debug_log "GPG_TTY set to $GPG_TTY"
}

# Main execution
main() {
    setup_terminal
    enhanced_logging
    local pinentry
    pinentry=$(command -v pinentry-curses || true)
    if [ -z "$pinentry" ]; then
        debug_log "No pinentry found"
        exit 1
    fi
    debug_log "Selected pinentry: $pinentry"
    exec "$pinentry" "$@"
}

main "$@"
