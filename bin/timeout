#!/bin/sh
# Cross-platform timeout implementation
# Works on macOS (BSD) and Linux (GNU) without external dependencies
#
# Timestamp: 2025-01-13T20:07Z Version: 1.0.0

set -eu

# Configuration
SCRIPT_NAME="$(basename "$0")"
OS_TYPE="$(uname -s)"

# Display usage information
usage() {
    cat << EOF
Usage: $SCRIPT_NAME [OPTION] DURATION COMMAND [ARG]...
Run COMMAND with a time limit of DURATION seconds.

Options:
  -h, --help     Show this help message

Examples:
  $SCRIPT_NAME 30 ping google.com
  $SCRIPT_NAME 5 curl -s https://example.tld
EOF
    exit 1
}

# Validate duration format
validate_duration() {
    local duration="$1"
    case "$duration" in
        ''|*[!0-9]*)
            echo "Error: Invalid duration: $duration" >&2
            exit 1
            ;;
    esac
}

# Detect available timeout command (excluding our own script)
detect_timeout_cmd() {
    # Check for gtimeout first (GNU coreutils via MacPorts)
    if command -v gtimeout >/dev/null 2>&1; then
        echo "gtimeout"
        return
    fi
    
    # Check for system timeout, but exclude our own script
    local timeout_path
    timeout_path="$(command -v timeout 2>/dev/null || true)"
    
    if [ -n "$timeout_path" ] && [ "$timeout_path" != "$(realpath "$0" 2>/dev/null || echo "$0")" ]; then
        # Found a timeout that's not our script
        echo "timeout"
        return
    fi
    
    # No external timeout found
    echo ""
}

# Execute with timeout using Perl fallback
exec_perl_timeout() {
    local duration="$1"
    shift
    exec perl -e "alarm $duration; exec @ARGV" -- "$@"
}

# Main execution function
exec_with_timeout() {
    local duration="$1"
    shift
    
    validate_duration "$duration"
    
    local timeout_cmd
    timeout_cmd="$(detect_timeout_cmd)"
    
    case "$timeout_cmd" in
        "gtimeout")
            exec gtimeout "$duration" "$@"
            ;;
        "timeout")
            exec timeout "$duration" "$@"
            ;;
        "")
            case "$OS_TYPE" in
                "Darwin")
                    exec_perl_timeout "$duration" "$@"
                    ;;
                *)
                    echo "Error: No timeout command available on this system" >&2
                    exit 1
                    ;;
            esac
            ;;
    esac
}

# Parse arguments
main() {
    if [ $# -lt 2 ]; then
        usage
    fi
    
    case "$1" in
        -h|--help)
            usage
            ;;
        *)
            exec_with_timeout "$@"
            ;;
    esac
}

# Execute main function
main "$@"
